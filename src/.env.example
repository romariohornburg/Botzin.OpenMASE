MASE_PORT=33600
HB_PORT=27999
BUDDY_PORT=33650
SERVERLIST_PORT=28002
XTEA_KEY=ea818d6680d950355f25f0fef854373e

WELCOME_BROADCAST_MESSAGE=<just:center><spush><color:E3FF0E><font:Ozone:38>BOTZIN!!! - <color:FF3333>W.I.P!<spop><br>Quaisquer bugs, favor comunicar <spush><color:00FF00>@mdolli<spop> no Discord!<br>https://github.com/iagoMAO/Botzin.OpenMASE

# Banco de dados e catálogo de itens (carregado automaticamente se a tabela estiver vazia)
DB_PATH=./botzin.db
# Vazio = procura em sql/items.sql e ../sql/items.sql
ITEMS_SQL_PATH=

# Página de cadastro (HTTP). Vazio = desabilitada.
REGISTER_PORT=8080
STARTING_CREDITS=50000
STARTING_GOLD=0

# true: o login no Buddy precisa do token entregue no login do MASE (magic number).
# false: aceita o login no Buddy vindo do mesmo IP da sessão do MASE.
SESSION_TOKEN_AUTH=true

# Pontuação por partida. O host da partida envia o relatório de todos os jogadores
# (kills, bots vivos, quem caiu); a fórmula é nossa, o cliente só exibe o resultado.
SCORE_KILL_POINTS=10
SCORE_ALIVE_POINTS=5
SCORE_WIN_POINTS=50
SCORE_DROP_PENALTY=20
CREDITS_PER_POINT=10
MIN_SCORE_INTERVAL_SECONDS=60
# Anúncio extra com "+pontos, +XP, +créditos" (a tela de fim de jogo já mostra o resultado)
SCORE_NOTIFY=false

# Venda devolve essa porcentagem do preço
SELL_RATIO_PERCENT=50

# Limites dos atributos (ST/DX/IQ/HT). A soma não pode passar do total base do bot
# + ATTRIB_POINTS_PER_LEVEL por nível.
ATTRIB_MIN=0
ATTRIB_MAX=250
ATTRIB_POINTS_PER_LEVEL=2
